{
  "name": "dsh-speed",
  "version": "0.2.0",
  "type": "module",
  "description": "Account-aware Fast and Ultrafast inside the DSH Model/Effort modal, including trusted ProviderProxy",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/core.test.js test/client.test.js test/proxy.test.js test/modal.test.js test/real-runtime.test.js",
    "test:live": "node test/live.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "devDependencies": {
    "fast-check": "^4.10.2",
    "playwright": "^1.64.0"
  }
}
