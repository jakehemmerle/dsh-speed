{
  "name": "dsh-speed",
  "version": "0.1.1",
  "type": "module",
  "description": "Model-aware Fast and Ultrafast picker for DSH OpenAI and Codex routes",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:live": "node test/live.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "devDependencies": {
    "fast-check": "^4.10.2",
    "playwright": "^1.64.0"
  }
}
