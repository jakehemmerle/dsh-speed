--- a/lib/types/effortCycle.js
+++ b/lib/types/effortCycle.js
@@ -0,0 +1,49 @@
+/**
+ * omp-style reasoning-effort cycling (nix-config dsh-omp-keys patch).
+ *
+ * Shift+Tab steps the live route's effort ladder forward and wraps, the way
+ * omp's `app.thinking.cycle` does. The ladder and the write path are the ones
+ * `/effort` uses (`listEfforts` / `setEffort`), so the choice persists exactly
+ * like a slider pick.
+ */
+/**
+ * The level after `current` on `levels`, wrapping. An unknown or absent
+ * current level starts at the first rung. Undefined when there is nothing
+ * to cycle (no ladder, or a single rung).
+ */
+export function nextEffort(levels, current) {
+    if (levels.length < 2)
+        return undefined;
+    const index = current === undefined ? -1 : levels.indexOf(current);
+    return levels[(index + 1) % levels.length];
+}
+let inFlight = false;
+/** Advance the live session to the next effort level and toast it. */
+export async function cycleEffort(channel) {
+    // Holding Shift+Tab repeats faster than the route's list resolves; extra
+    // presses while one step is pending are dropped instead of racing.
+    if (inFlight)
+        return;
+    inFlight = true;
+    try {
+        const { efforts, defaultEffort } = await channel.listEfforts();
+        const levels = efforts.map(effort => effort.id);
+        if (levels.length === 0)
+            return; // listEfforts already notified (unsupported / unavailable)
+        const next = nextEffort(levels, channel.reasoningEffort ?? defaultEffort);
+        if (next === undefined) {
+            channel.notify(`Effort: ${levels[0]} (only level)`, { timeoutMs: 2000 });
+            return;
+        }
+        if (await channel.setEffort(next)) {
+            const label = efforts.find(effort => effort.id === next)?.name ?? next;
+            channel.notify(`Effort: ${label}`, { timeoutMs: 1500 });
+        }
+    }
+    catch (error) {
+        channel.notify(`Effort switch failed: ${error instanceof Error ? error.message : String(error)}`, { color: 'error', timeoutMs: 6000 });
+    }
+    finally {
+        inFlight = false;
+    }
+}
